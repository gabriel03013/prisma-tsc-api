generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id         Int       @id(map: "usuario_pkey") @default(autoincrement())
  name       String    @db.VarChar(100)
  email      String    @unique(map: "usuario_email_key") @db.VarChar(100)
  password   String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  address    address[]
  order      order[]
  review     review[]
}

model address {
  id       Int     @id(map: "endereco_pkey") @default(autoincrement())
  user_id  Int
  street   String? @db.VarChar(200)
  city     String? @db.VarChar(100)
  state    String? @db.VarChar(50)
  zip_code String? @db.VarChar(20)
  user     user    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "endereco_usuarioid_fkey")
}

model category {
  id          Int       @id(map: "categoria_pkey") @default(autoincrement())
  name        String    @db.VarChar(100) @unique
  description String?
  product     product[]
}

model product {
  id          Int          @id(map: "produto_pkey") @default(autoincrement())
  name        String       @db.VarChar(100)
  description String?
  price       Decimal      @db.Decimal(10, 2)
  category_id Int?
  supplier_id Int?
  order_item  order_item[]
  category    category?    @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "produto_categoriaid_fkey")
  supplier    supplier?    @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "produto_fornecedorid_fkey")
  review      review[]
  stock       stock?
}

model review {
  id         Int       @id(map: "avaliacao_pkey") @default(autoincrement())
  user_id    Int
  product_id Int
  rating     Int?
  comment    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "avaliacao_usuarioid_fkey")
  product    product   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "avaliacao_produtoid_fkey")

  @@unique([user_id, product_id], map: "avaliacao_usuario_produto_unique")
}

model stock {
  id         Int      @id(map: "estoque_pkey") @default(autoincrement())
  product_id Int      @unique
  quantity   Int      @default(0)
  product    product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "estoque_produtoid_fkey")
}

model supplier {
  id      Int       @id(map: "fornecedor_pkey") @default(autoincrement())
  name    String    @db.VarChar(100)
  contact String?   @db.VarChar(100)
  product product[]
}

model order {
  id         Int          @id(map: "pedido_pkey") @default(autoincrement())
  user_id    Int
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  status     String?      @default("PENDENTE") @db.VarChar(50)
  user       user         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pedido_usuarioid_fkey")
  order_item order_item[]
  payment    payment[]
}

model order_item {
  id         Int      @id(map: "produtopedido_pkey") @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int
  unit_price Decimal  @db.Decimal(10, 2)
  order      order    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "produtopedido_pedidoid_fkey")
  product    product  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "produtopedido_produtoid_fkey")
}

model payment {
  id         Int       @id(map: "pagamento_pkey") @default(autoincrement())
  order_id   Int
  method     String?   @db.VarChar(50)
  status     String?   @db.VarChar(50)
  amount     Decimal?  @db.Decimal(10, 2)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  order      order     @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pagamento_pedidoid_fkey")
}